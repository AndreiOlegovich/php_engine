# Per-site values for the tools and tests. Copy to site-profile.env (ignored
# by git) and fill in. Every key has a generic default, so a missing file
# only makes the tests that need the key skip.
SITE_URL="https://example.com"
SITE_DEV_URL="https://dev.example.com"
SITE_LOCAL_URL="http://127.0.0.1:8080"
SITE_OWN_HOSTS="example.com www.example.com"
SITE_LANG_DIRS="ru"
SITE_ENGINE_DIRS=".php"
SITE_PAGE_CLASSES="ArticlePage Page BasePage DictPage"
SITE_PAGE_MARKERS="Page_html_id BasePage_html_id ArticlePage_html_id"
SITE_NO_MARKER_PATHS=""
SITE_BOTTOM_MARKER="</html>"
# Named markers for --tag of test_content_loaded.py: name=HTML, "|" between
# alternatives, ";" between names. HTML, not CSS: a piece of the page source.
# Single quotes when a value holds double quotes, e.g.
# SITE_TAG_MARKERS='menu=<nav class="menu"|<nav id="top">; footer=id="footer-end"'
SITE_TAG_MARKERS=""
SITE_TREE_SHEETS="src=/.css/site.css"
SITE_HEADER_INCLUDES="010_header.php 020_header.php _head_inc.php"
SITE_WRAPPER_CLASSES="wrapper wrapper-base-page"
SITE_FOOTER_TABLE="tab11"
SITE_QUIZ_CLASS="LessonQuiz"
SITE_SEARCH_CLASS="SiteSearch"
SITE_FEED_DIR="feed"
SITE_GENERATED_CARD_DIRS=""
SITE_LOG_DIR=""
SITE_PHP_VERSION="8.5"
# The hosting the site is uploaded to (not the one it came from): beget,
# dreamhost, apache-proxy, apache-tls, litespeed, nginx or unknown.
# container/tools/htaccess_hosting.py checks the .htaccess files against it.
SITE_HOSTING=""
SITE_DRAFT_MARKER="draft"
