# Site settings (TEMPLATE — copy to site.env and fill in).
# Never put FTP_PASSWORD here; it lives only in the outside secret file
# (chmod 600, never committed).
# Scripts read this file when SITE_ENV is set, otherwise built-ins apply
# (commands run from container/, so SITE_ENV is relative to it):
#   SITE_ENV=scripts/site.env ./scripts/deploy-ftp.sh ...
# To create your working copy, run:
#   cp site.env.example site.env
# and fill in your values below.

# --- FTP (mirror of the secret creds file, minus the password) ---
FTP_HOST=""
FTP_PORT="21"
FTP_USER=""
FTP_PASSWORD=""
FTP_REMOTE_DIR="/public_html"
FTP_USE_TLS="false"
FTP_TIMEOUT="30"

# --- Sites ---
PROD_URL="https://example.com"
PROD_URL_WWW="https://www.example.com"
DEV_URL="https://dev.example.com"
LOCAL_BASE_URL="http://127.0.0.1:8080"

# --- Hosting paths (absolute on the server) ---
DEV_DOCROOT="/home/user/dev/public_html"
PROD_DOCROOT="/home/user/example.com/public_html"
# Prefix stripped when mapping prod log paths back to the repo tree.
DOCROOT_PREFIX="/home/user/example.com/public_html/"

# --- Hosting logs (remote dirs + dev filename prefix at FTP root) ---
PROD_LOG_DIR="prod_logs"
DEV_LOG_DIR="dev_logs"
ROOT_PREFIX="dev.example.com."
