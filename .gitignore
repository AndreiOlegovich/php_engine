# Generated reports (link-checker output)
reports/
allure-results/
**/allure-results-host/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
venv/

# Logs (incl. PHP error logs and login-attempt logs)
*.log

# SQLite / DB binaries
*.db
*.sqlite
*.sqlite3
*.db-journal

# Editor / backup duplicates ("name copy.php", "name copy(1).css", ...)
# NOTE: leading space is intentional — a bare *copy* would also match
# legit files like optical_spectroscopy.php or windows/robocopy/.
* copy*
*.bak
*.orig
*~
*.swp
*.swo
.DS_Store
Thumbs.db

# PHP session data files (runtime junk inside demo tmp/ dirs)
sess_*

# Generated sitemaps (checked-in sitemap.xml stays tracked)
sitemap_new.xml

# Secrets / local env
site-profile.env
.env
.env.*
*.key
*.pem
id_rsa*
.htpasswd
*-creds.env
ftp-creds.env
hosting-access.env

# Images stay out of the repo: a big site holds gigabytes of them. The local
# site still shows them, because the files are in container/src. Instead,
# container/docs/image-files.txt is tracked: the image-list hook records each
# image's path, size and sha1 there (container/tools/images/image_list.py).
# To keep a site's images in git, delete these lines before its first commit.
# Any letter case: git matches case-sensitively, and an imported site often
# holds camera files such as IMG_0001.JPG.
*.[jJ][pP][gG]
*.[jJ][pP][eE][gG]
*.[pP][nN][gG]
*.[gG][iI][fF]
*.[wW][eE][bB][pP]
*.[sS][vV][gG]
*.[iI][cC][oO]
*.[bB][mM][pP]
*.[aA][vV][iI][fF]
*.[tT][iI][fF][fF]
*.[tT][iI][fF]
