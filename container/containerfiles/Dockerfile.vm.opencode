# The image of Dockerfile.opencode plus the languages of src/dev that run on
# a virtual machine, so the agent can build and run the examples of their
# pages: Java (java, javac, jshell, mvn), Groovy (groovy, groovyc), .NET
# (dotnet with C# and F#), Erlang (erl, erlc, escript), Elixir (elixir, iex,
# mix) and the Thrift compiler (thrift), which generates code for them, with
# the checkers their toolchains bring: checkstyle, google-java-format, PMD,
# SpotBugs and the JUnit launcher for Java, dotnet format inside the SDK, rebar3 and erlc for Erlang, mix format
# for Elixir, and shellcheck and shfmt for the shell snippets. The other
# languages are in Dockerfile.native.opencode and Dockerfile.script.opencode.
# OpenCode for --auto runs on an agent worktree. The official image, plus
# PHP 8.5 for php -l and page renders, bash, Python, Perl and the GNU tools
# for the scripts in container/tools, and a user with your UID, so the files
# the agent writes stay yours.
#
# To leave a language out, put # in front of its package line in the RUN
# below and in front of the lines of its block after that RUN (Java and the
# RUN that installs its checkers, .NET, Groovy): Docker skips a comment line
# inside a continued RUN. The next run of opencode-docker.sh rebuilds the
# image. Leave the lines above the first language and the last line
# (&& ln -s ...) as they are.
# Groovy needs Java, Elixir needs Erlang: leave them out together.
FROM ghcr.io/anomalyco/opencode:2.1.4
RUN apk add --no-cache bash python3 perl grep sed findutils coreutils \
    php85 php85-ctype php85-dom php85-iconv php85-mbstring php85-session \
    php85-simplexml php85-tokenizer php85-xml \
# Java: the JDK 21 and Maven. Groovy needs it.
    openjdk21-jdk maven \
# .NET: the SDK with C# and F#.
    dotnet10-sdk \
# Erlang/OTP, which has edoc and erlc, and rebar3 (3.27.3), its build tool.
# There is no dialyzer: /usr/bin/dialyzer is in the erlang27-dialyzer package
# only, and that package depends on erlang27-wx, so it pulls the
# wxwidgets/gtk/webkit stack, about 570 MB. The erlang image (--erlang) has
# dialyzer; this one does not.
    erlang rebar3~=3.27 \
# Elixir.
    elixir \
# The Thrift compiler.
    thrift \
# Shell: shellcheck 0.11.0 and shfmt 3.13.1, for the bash snippets of the
# pages and the scripts in container/tools.
    shellcheck~=0.11 shfmt~=3.13 \
 && ln -s /usr/bin/php85 /usr/local/bin/php
# Java.
ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk
# Java checkers and the test runner: checkstyle 14.4.0, google-java-format
# 2.0.0 and the JUnit console launcher 1.14.3, each a single self-contained
# jar run through a wrapper on PATH that calls java, then PMD 7.29.0 and
# SpotBugs 4.9.8 in the RUN after this one. The Maven cache of the image is
# empty, so `mvn test` cannot fetch JUnit: use the launcher jar instead. To
# leave Java out, put # in front of both RUNs.
#   checkstyle -c /google_checks.xml File.java
#   google-java-format --dry-run File.java
#   javac -cp /opt/java-tools/junit-platform-console-standalone.jar -d out T.java
#   junit execute --class-path out --scan-classpath
#   pmd check -d src -R rulesets/java/quickstart.xml -f text
#   spotbugs -textui out    (it reads compiled classes, so build first)
# The google-java-format jar and its sha256 come from Maven Central, which
# publishes the checksum next to the file. checkstyle publishes its -all jar
# only as a release asset of the project on GitHub, with no checksum file, so
# the sha256 below is the one of the 14.4.0 asset when this line was written:
# an asset that changes in place stops the build. The google-java-format
# wrapper passes the --add-exports flags its README lists for JDK 16 and up.
ARG CHECKSTYLE_VERSION=14.4.0
ARG CHECKSTYLE_SHA256=c0a521e54eabd1ece4ff7bd84cf231b012615745ed3aa4fb27ab0ca73097250c
ARG GOOGLE_JAVA_FORMAT_VERSION=2.0.0
ARG GOOGLE_JAVA_FORMAT_SHA256=c78feb48c549fa7114b7ea11db3b456808f7b371ffe84e6643a44dd2f9588639
ARG JUNIT_VERSION=1.14.3
ARG JUNIT_SHA256=909a20a8b173aca348fb7c1bb6dc8d9b234d3095c5b52b81699d742e14a7f61a
RUN mkdir -p /opt/java-tools \
 && wget -q -O /opt/java-tools/checkstyle-all.jar \
    "https://github.com/checkstyle/checkstyle/releases/download/checkstyle-${CHECKSTYLE_VERSION}/checkstyle-${CHECKSTYLE_VERSION}-all.jar" \
 && echo "${CHECKSTYLE_SHA256}  /opt/java-tools/checkstyle-all.jar" | sha256sum -c - \
 && wget -q -O /opt/java-tools/google-java-format-all-deps.jar \
    "https://repo1.maven.org/maven2/com/google/googlejavaformat/google-java-format/${GOOGLE_JAVA_FORMAT_VERSION}/google-java-format-${GOOGLE_JAVA_FORMAT_VERSION}-all-deps.jar" \
 && echo "${GOOGLE_JAVA_FORMAT_SHA256}  /opt/java-tools/google-java-format-all-deps.jar" | sha256sum -c - \
 && wget -q -O /opt/java-tools/junit-platform-console-standalone.jar \
    "https://repo1.maven.org/maven2/org/junit/platform/junit-platform-console-standalone/${JUNIT_VERSION}/junit-platform-console-standalone-${JUNIT_VERSION}.jar" \
 && echo "${JUNIT_SHA256}  /opt/java-tools/junit-platform-console-standalone.jar" | sha256sum -c - \
 && printf '%s\n' '#!/bin/sh' \
    'exec java -jar /opt/java-tools/junit-platform-console-standalone.jar "$@"' \
    > /usr/local/bin/junit \
 && printf '%s\n' '#!/bin/sh' \
    'exec java -jar /opt/java-tools/checkstyle-all.jar "$@"' \
    > /usr/local/bin/checkstyle \
 && printf '%s\n' '#!/bin/sh' \
    'exec java --add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED --add-exports=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED --add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED --add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED --add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED --add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED -jar /opt/java-tools/google-java-format-all-deps.jar "$@"' \
    > /usr/local/bin/google-java-format \
 && chmod +x /usr/local/bin/checkstyle /usr/local/bin/google-java-format /usr/local/bin/junit
# PMD (rules on the source) and SpotBugs (bug patterns in the compiled
# classes): each is a distribution folder with its own jars, so each gets a
# wrapper that calls its script. SpotBugs comes from Maven Central, which
# publishes the checksum next to the archive. PMD publishes its archive only
# as a release asset on GitHub, whose API shows the sha256 below for 7.29.0
# when this line was written (the archive is 135 MB).
ARG PMD_VERSION=7.29.0
ARG PMD_SHA256=d27177c185b837fa57f097e482d1253468aa035379c5eb2671fa0a279109b179
ARG SPOTBUGS_VERSION=4.9.8
ARG SPOTBUGS_SHA256=2eb8e0f2b223c22ffa2ce0c1cf1be4127dde19d240b8f7ce69a5fd3ad5c36ff3
RUN wget -q -O /tmp/pmd.zip \
    "https://github.com/pmd/pmd/releases/download/pmd_releases/${PMD_VERSION}/pmd-dist-${PMD_VERSION}-bin.zip" \
 && echo "${PMD_SHA256}  /tmp/pmd.zip" | sha256sum -c - \
 && unzip -q /tmp/pmd.zip -d /opt \
 && mv "/opt/pmd-bin-${PMD_VERSION}" /opt/pmd \
 && wget -q -O /tmp/spotbugs.tgz \
    "https://repo1.maven.org/maven2/com/github/spotbugs/spotbugs/${SPOTBUGS_VERSION}/spotbugs-${SPOTBUGS_VERSION}.tgz" \
 && echo "${SPOTBUGS_SHA256}  /tmp/spotbugs.tgz" | sha256sum -c - \
 && tar -xzf /tmp/spotbugs.tgz -C /opt \
 && mv "/opt/spotbugs-${SPOTBUGS_VERSION}" /opt/spotbugs \
 && rm /tmp/pmd.zip /tmp/spotbugs.tgz \
 && printf '%s\n' '#!/bin/sh' 'exec /opt/pmd/bin/pmd "$@"' > /usr/local/bin/pmd \
 && printf '%s\n' '#!/bin/sh' 'exec /opt/spotbugs/bin/spotbugs "$@"' > /usr/local/bin/spotbugs \
 && chmod +x /usr/local/bin/pmd /usr/local/bin/spotbugs
# .NET.
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1
# Groovy is not an Alpine package: the binary archive of Apache, checked
# against the sha256 that Apache publishes next to it. To leave Groovy out,
# put # in front of every line from ARG GROOVY_VERSION to its ENV.
ARG GROOVY_VERSION=5.0.8
ARG GROOVY_SHA256=3b754e2ba201bcb8d31401a403a8b0a8e41c97de108eb1b49fc1e2b6e96b252b
RUN wget -q -O /tmp/groovy.zip \
    "https://archive.apache.org/dist/groovy/${GROOVY_VERSION}/distribution/apache-groovy-binary-${GROOVY_VERSION}.zip" \
 && echo "${GROOVY_SHA256}  /tmp/groovy.zip" | sha256sum -c - \
 && unzip -q /tmp/groovy.zip -d /opt \
 && mv "/opt/groovy-${GROOVY_VERSION}" /opt/groovy \
 && rm /tmp/groovy.zip /opt/groovy/bin/*.bat
ENV GROOVY_HOME=/opt/groovy PATH=/opt/groovy/bin:$PATH
# The system Python's libraries for the examples of the pages: numpy 2.4.6
# and gunicorn 25.2.0, Alpine packages so nothing is compiled or fetched.
# They are NOT in /opt/lint, which stays the linters' venv; the examples of
# the pages run with plain python3, which does not see a venv.
# Python linters at the versions of .pre-commit-config.yaml (ruff, mypy,
# pylint), pytest, and bandit (1.9.4) for the security lint of the scripts in
# container/tools, in their own venv with the commands on PATH, so the agent
# can run the commit gates on the Python it writes:
#   ruff format --config container/pyproject.toml FILE
#   ruff check --config container/pyproject.toml FILE
#   mypy --config-file container/pyproject.toml FILE
#   pylint --rcfile=container/pyproject.toml FILE
#   bandit -r container/tools
# Keep the three versions equal to the rev lines of .pre-commit-config.yaml.
RUN apk add --no-cache py3-pip py3-numpy~=2.4 py3-gunicorn~=25.2 \
 && python3 -m venv /opt/lint \
 && /opt/lint/bin/pip install --no-cache-dir ruff==0.16.8 mypy==2.3.1 \
    pylint==4.0.8 pytest requests allure-pytest pyyaml bandit==1.9.4 \
 && ln -s /opt/lint/bin/ruff /opt/lint/bin/mypy /opt/lint/bin/pylint \
    /opt/lint/bin/pytest /opt/lint/bin/bandit /usr/local/bin/
ARG HOST_UID=1000
ARG HOST_GID=1000
RUN addgroup -g ${HOST_GID} agent \
 && adduser -D -u ${HOST_UID} -G agent agent \
 && mkdir -p /work && chown agent:agent /work
USER agent
# Created by the user, so a new named volume mounted here is writable.
RUN mkdir -p /home/agent/.local/share/opencode
WORKDIR /work
