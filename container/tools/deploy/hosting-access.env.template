# Hosting access: FTP/FTPS (deploy-ftp.sh) and SSH (deploy-ssh.sh) settings.
# version 1.0.0
#
# WHERE TO PUT IT (outside the repo, never committed):
#   mkdir -p ~/.config/php_engine
#   chmod 700 ~/.config/php_engine
#   install -m 600 hosting-access.env.template ~/.config/php_engine/hosting-access.env
#   $EDITOR ~/.config/php_engine/hosting-access.env
#   (run the install line from container/tools/deploy/, or give the full path)
#
# WHICH RIGHTS:
#   file     600 (rw-------), owner only
#   folder   700 (rwx------) for ~/.config/php_engine
#   check:   stat -c '%a %n' ~/.config/php_engine ~/.config/php_engine/hosting-access.env
#
# FORMAT:
#   KEY="value", one per line, no spaces around "=", every value in double
#   quotes (the FTP scripts source this file with bash). Lines starting with
#   # are comments. A password with a " or $ must be escaped for bash.
#   Environment variables of the same names override the file; command-line
#   flags override both. The scripts read only this file: there is no
#   fallback to older file names.
#
# NEVER: put this file under container/ (the FTP scripts refuse it there),
# paste its values into site.env, or commit it.


# ---------------------------------------------------------------------------
# FTP/FTPS hosting
# Used by: deploy-ftp.sh, deploy-batches.sh, analyze_logs/download-logs.sh,
#          analyze_logs/fetch-logs.sh
# ---------------------------------------------------------------------------

# Host name of the FTP server, without ftp://. Required.
FTP_HOST="ftp.example.com"

# Login from the hosting control panel. Required.
FTP_USER="hosting_user"

# Password of that login. Required. Keep it in this file only.
FTP_PASSWORD="change-me"

# Port. Optional, default 21.
FTP_PORT="21"

# Remote folder that is the site root for deploy-ftp.sh. Optional, default /.
FTP_REMOTE_DIR="/public_html"

# "true" for explicit FTPS (TLS), "false" for plain FTP. Optional, default false.
FTP_USE_TLS="false"

# Seconds before a connection attempt gives up. Optional, default 30.
FTP_TIMEOUT="30"


# ---------------------------------------------------------------------------
# SSH hosting
# Used by: deploy-ssh.sh, analyze_logs/fetch_hosting_logs.py
# ---------------------------------------------------------------------------

# user@server of the shell user that owns the site, or a Host alias from
# ~/.ssh/config. Required for SSH. Login is by key only, no password.
HOSTING_SSH="user@server.example.com"

# Private SSH key whose public half is in ~/.ssh/authorized_keys on the host.
# Optional. When empty, ~/.ssh/hosting-upload is used if that file exists.
HOSTING_KEY="~/.ssh/hosting-upload"

# Docroot relative to the remote home, for deploy-ssh.sh. Optional, default example.com.
HOSTING_DOCROOT="example.com"
