# SSH settings for deploy-ssh.sh and analyze_logs/fetch_hosting_logs.py.
#
# Copy OUTSIDE the repo and fill in; the scripts read it from there:
#   install -m 600 container/tools/deploy/deploy-ssh.env.example ~/.config/php_engine/hosting.env
#
# Plain KEY=value lines; the file is parsed, never sourced. Environment
# variables of the same names win over it, command-line flags over both.
# No password: login is by key only (ssh BatchMode).

# user@server of the shell user that owns the site, or a Host alias
# from ~/.ssh/config.
HOSTING_SSH=<user>@<server>.example.com

# Private key whose public half is in ~/.ssh/authorized_keys on the host.
# Optional: ~/.ssh/hosting-upload is used when it exists.
HOSTING_KEY=~/.ssh/hosting-upload

# Docroot relative to the remote home (deploy-ssh.sh only).
HOSTING_DOCROOT=example.com
